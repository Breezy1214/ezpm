{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run ezpm VS Code Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--disable-extensions",
				"--user-data-dir=${workspaceFolder}/.vscode-test/user-data",
				"--extensions-dir=${workspaceFolder}/.vscode-test/extensions",
				"--extensionDevelopmentPath=${workspaceFolder}/vscode-ezpm"
			],
			"outFiles": [
				"${workspaceFolder}/vscode-ezpm/out/**/*.js"
			],
			"preLaunchTask": "build vscode-ezpm"
		}
	]
}
